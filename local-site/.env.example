# Copie para .env e ajuste antes de executar.
PORT=8787
HOST=127.0.0.1
# Origens autorizadas separadas por vírgula. Adicione sua URL do GitHub Pages e
# a URL do túnel HTTPS quando configurar acesso público.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Caminho do banco SQLite. Por padrão: local-site/data/whitespace.sqlite
DB_PATH=
# Gere um segredo aleatório longo e privado para assinar/configurar o servidor.
# Não publique este arquivo nem o segredo.
SERVER_SECRET=
